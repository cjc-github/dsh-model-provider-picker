{
  "name": "dsh-model-provider-picker",
  "version": "1.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjc-github/dsh-model-provider-picker.git"
  },
  "homepage": "https://github.com/cjc-github/dsh-model-provider-picker#readme",
  "description": "厂商优先的两级模型选择器、按厂商/模型隐藏的可见性设置，以及一键添加常见厂商的预设库。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-picker",
    "model-provider",
    "deepseek-harness"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/visibility.test.mjs && node test/prototype.test.mjs && node test/presets.test.mjs",
    "screenshots": "node docs/screenshot.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.56.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
